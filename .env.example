# Copy to .env and fill in.

# Telegram — required for alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX — leave empty for public-only access (market data, funding, OI, ratios).
# Required for live execution with EXECUTION_DRY_RUN=false.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# PYTHONPATH — required locally: src/crypt/ must come before the deprecated
# stdlib crypt.py (Python 3.12) in sys.path, otherwise `python -m crypt`
# silently runs the stdlib module and exits with code 0.
# On Railway this is baked into the startCommand in railway.toml.
PYTHONPATH=src

# Numba — pandas-ta 0.4.x pulls in numba/llvmlite.
# Set to 1 to prevent LLVM from hanging on startup in containers.
NUMBA_DISABLE_JIT=1

# Runtime
LOG_LEVEL=INFO
# Directory for log files. Default: logs/
# On Railway set LOG_DIR=data/logs so logs land on the persistent volume.
# LOG_DIR=logs
# Comma-separated OKX SWAP instrument IDs to monitor.
SYMBOLS=SOL-USDT-SWAP,TON-USDT-SWAP,XPL-USDT-SWAP
# Confidence threshold (0..100) above which a BUY/SELL verdict is alerted to Telegram.
ALERT_CONFIDENCE_THRESHOLD=75

# OKX fetch retry / backoff tuning (optional — defaults shown).
# OKX_MAX_RETRIES=5
# OKX_RETRY_BASE_DELAY=2.0
# OKX_RETRY_MAX_DELAY=60.0

# Coinglass — no longer used for backfill (ADR-0016; OKX native endpoints
# cover OI and L/S ratio history back to Feb 2024). Reserved for future
# liquidations engine (ADR-0012).

# ─── M4 Live Execution (ADR-0033, ADR-0048) ─────────────────────────────────
# Gate: set to true only after a candidate is manually promoted OR the owner
# explicitly overrides the mandate gate in chat.
EXECUTION_ENABLED=false

# When true: all sizing, signal, and SL/TP logic runs but no orders are placed.
# Always start with dry_run=true and verify logs before flipping to false.
EXECUTION_DRY_RUN=true
# Optional: size dry-run orders as if the account had this much USDT. This is
# ignored when EXECUTION_DRY_RUN=false. Keep 0 to use the real OKX balance.
EXECUTION_DRY_RUN_CAPITAL=0

# Path to the strategy JSON config used for live signal generation. The live
# runner loads it through the same backtester registry as `backtester run`.
EXECUTION_STRATEGY_CONFIG=strategies/archive/filtered_donor_portfolio_causal_v3_core4.json

# Symbols to trade (subset or equal to SYMBOLS above).
EXECUTION_SYMBOLS=SOL-USDT-SWAP

# State file for crash-safe position tracking.
# On Railway: use a path on the persistent volume.
EXECUTION_STATE_PATH=data/live_positions.json

# Parquet data directory (must match DATA_DIR / the directory the ingestor writes to).
EXECUTION_DATA_DIR=data

# Fallback execution parameters for legacy single-signal strategies. Core4 v3
# signal_events carry their own donor-level overrides for risk, RRR, TTL, and
# exit geometry; these values are used only when the event omits an override.
EXECUTION_EXIT_GEOMETRY=sl_rrr
EXECUTION_TP_MOVE_PCT=0.016
EXECUTION_STRUCTURAL_SL_MODE=cap
EXECUTION_MIN_TP_MOVE_PCT=0.004
EXECUTION_RRR=2.0
EXECUTION_TTL_BARS=0
EXECUTION_RISK_PERCENT=1.0
EXECUTION_TRAIL_ACTIVATION_RRR=0.0
EXECUTION_TRAIL_DISTANCE_ATR=0.0

# Owner rule: do not cap max positions for Core4 v3. In the backtester and live
# execution, 0 means unlimited subject to shared margin/capital guards.
EXECUTION_MAX_POSITIONS=0
EXECUTION_MAX_LEVERAGE=25
EXECUTION_RISK_BASE_PERIOD=monthly

# Taker / maker fee rates (fraction, not percent). Match OKX VIP0 defaults.
EXECUTION_TAKER_FEE=0.0005
EXECUTION_MAKER_FEE=0.0002
EXECUTION_INSTRUMENT_PRECISION_POLICY=okx_sol_usdt_swap_2026_07_01

# Safety: skip new entries when total locked margin reaches this percent of
# account balance. Full exchange sync must be clean before any new entry.
EXECUTION_MAX_CAPITAL_RISK_PCT=100.0
# Alert when fill differs from the H1 backtest open; never blocks entry.
EXECUTION_MAX_ENTRY_DRIFT_PCT=0.001
EXECUTION_MAINTENANCE_MARGIN_RATE=0.004
EXECUTION_LIQUIDATION_FEE_RATE=0.0005
EXECUTION_LIQUIDATION_BUFFER_PCT=0.005
EXECUTION_MAINTENANCE_MARGIN_TIER_SCHEDULE=okx_sol_usdt_swap_2026_06_29
EXECUTION_MIN_NET_EXPOSURE=0.01
EXECUTION_MAX_ALLOWED_MARGIN=1.0
EXECUTION_REQUIRE_EXCHANGE_SYNC=true
