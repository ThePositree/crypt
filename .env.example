# Copy to .env and fill in.

# Telegram — required for alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX — leave empty for public-only access (market data, funding, OI, ratios).
# These will be needed once execution is wired up; not used in MVP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# PYTHONPATH — required locally: src/crypt/ must come before the deprecated
# stdlib crypt.py (Python 3.12) in sys.path, otherwise `python -m crypt`
# silently runs the stdlib module and exits with code 0.
# On Railway this is baked into the startCommand in railway.toml.
PYTHONPATH=src

# Numba — pandas-ta 0.4.x pulls in numba/llvmlite.
# Set to 1 to prevent LLVM from hanging on startup in containers.
NUMBA_DISABLE_JIT=1

# Runtime
LOG_LEVEL=INFO
# Directory for log files. Default: logs/
# On Railway set LOG_DIR=data/logs so logs land on the persistent volume.
# LOG_DIR=logs
# Comma-separated OKX SWAP instrument IDs to monitor.
SYMBOLS=SOL-USDT-SWAP,TON-USDT-SWAP,XPL-USDT-SWAP
# Confidence threshold (0..100) above which a BUY/SELL verdict is alerted to Telegram.
ALERT_CONFIDENCE_THRESHOLD=75

# OKX fetch retry / backoff tuning (optional — defaults shown).
# OKX_MAX_RETRIES=5
# OKX_RETRY_BASE_DELAY=2.0
# OKX_RETRY_MAX_DELAY=60.0

# Coinglass — no longer used for backfill (ADR-0016; OKX native endpoints
# cover OI and L/S ratio history back to Feb 2024). Reserved for future
# liquidations engine (ADR-0012).
