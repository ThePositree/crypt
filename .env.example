# Copy to .env and fill in.

# Telegram — required for alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX — leave empty for public-only access (market data, funding, OI, ratios).
# These will be needed once execution is wired up; not used in MVP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# PYTHONPATH — required locally: src/crypt/ must come before the deprecated
# stdlib crypt.py (Python 3.12) in sys.path, otherwise `python -m crypt`
# silently runs the stdlib module and exits with code 0.
# On Railway this is baked into the startCommand in railway.toml.
PYTHONPATH=src

# Numba — pandas-ta 0.4.x pulls in numba/llvmlite.
# Set to 1 to prevent LLVM from hanging on startup in containers.
NUMBA_DISABLE_JIT=1

# Runtime
LOG_LEVEL=INFO
# Directory for log files. Default: logs/
# On Railway set LOG_DIR=data/logs so logs land on the persistent volume.
# LOG_DIR=logs
# Comma-separated OKX SWAP instrument IDs to monitor.
SYMBOLS=SOL-USDT-SWAP,TON-USDT-SWAP,XPL-USDT-SWAP
# Confidence threshold (0..100) above which a BUY/SELL verdict is alerted to Telegram.
ALERT_CONFIDENCE_THRESHOLD=75

# OKX fetch retry / backoff tuning (optional — defaults shown).
# OKX_MAX_RETRIES=5
# OKX_RETRY_BASE_DELAY=2.0
# OKX_RETRY_MAX_DELAY=60.0

# Coinglass — no longer used for backfill (ADR-0016; OKX native endpoints
# cover OI and L/S ratio history back to Feb 2024). Reserved for future
# liquidations engine (ADR-0012).

# ─── M4 Live Execution (ADR-0033) ────────────────────────────────────────────
# Gate: set to true only after a candidate is manually promoted OR the owner
# explicitly overrides the mandate gate in chat.
EXECUTION_ENABLED=false

# When true: all sizing, signal, and SL/TP logic runs but no orders are placed.
# Always start with dry_run=true and verify logs before flipping to false.
EXECUTION_DRY_RUN=true

# Path to the strategy JSON config used for live signal generation.
# Must match the config used during backtesting.
EXECUTION_STRATEGY_CONFIG=strategies/backtester/crypt_ensemble_h1_discovery_nr4_vwap_robust.json

# Symbols to trade (subset or equal to SYMBOLS above).
EXECUTION_SYMBOLS=SOL-USDT-SWAP,TON-USDT-SWAP

# State file for crash-safe position tracking.
# On Railway: use a path on the persistent volume, e.g. data/execution_state.json
EXECUTION_STATE_FILE=data/execution_state.json

# Parquet data directory (must match DATA_DIR / the directory the ingestor writes to).
EXECUTION_DATA_DIR=data

# Risk parameters — must mirror the strategy config values exactly.
# See docs/execution/live_execution.md §3 for the full parity contract.
EXECUTION_RISK_PCT=0.02
EXECUTION_MAX_LEVERAGE=10
EXECUTION_TTL_BARS=48
EXECUTION_RRR=2.0

# Taker / maker fee rates (fraction, not percent). Match OKX VIP0 defaults.
EXECUTION_TAKER_FEE=0.0005
EXECUTION_MAKER_FEE=0.0002

# Safety: abort if a single position would risk more than this fraction of capital.
# Acts as a hard cap on top of risk_pct.
EXECUTION_MAX_CAPITAL_RISK_PCT=0.05

# Maximum number of concurrent open positions across all symbols.
EXECUTION_MAX_OPEN_POSITIONS=3
